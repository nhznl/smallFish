//@version=6
strategy(title="ProBorsa: RSI & SuperTrend Özel Dip Stratejisi", shorttitle="RSI + ST İkili Dip", format=format.price, precision=2, overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// =========================================================================
// 1. GİRDİLER (INPUTS)
// =========================================================================
// Sinyal sıklığını artırmak için RSI 14'ten 10'a düşürüldü.
rsiLengthInput = input.int(10, minval=1, title="RSI Uzunluğu", group="RSI Ayarları")
rsiSourceInput = input.source(close, "Kaynak", group="RSI Ayarları")
calculateDivergence = input.bool(false, title="Uyumsuzlukları Hesapla (Görsel)", group="RSI Ayarları")

// --- YENİ EKLENEN ÖZEL DİP AL GİRDİLERİ ---
sigLength = input.int(10, "RSI Kesişim (SMA) Periyodu", group="Özel Dip Al Stratejisi", tooltip="RSI'ın keseceği ortalama çizgisi")
triggerLevel = input.float(50, "Sıfırlama / Tetik Sınırı", group="Özel Dip Al Stratejisi", tooltip="RSI bu seviyenin altındayken başarısız kesişimleri sayar.")
targetCrossCount = input.int(2, "Kaçıncı AL Sinyali Özel Olsun?", minval=1, group="Özel Dip Al Stratejisi", tooltip="2 = İkili Dip (W) Formasyonu")

// --- SUPERTREND ÇIKIŞ GİRDİLERİ ---
atrPeriod = input.int(10, "SuperTrend ATR Periyodu", group="Çıkış (SuperTrend) Ayarları")
// Çıkışların daha kârlı noktalardan yapılabilmesi için çarpan 2.5 yapıldı.
stFactor = input.float(2.5, "SuperTrend Çarpanı", step=0.1, group="Çıkış (SuperTrend) Ayarları")

// =========================================================================
// 2. RSI VE SİNYAL HESAPLAMALARI
// =========================================================================
change_val = ta.change(rsiSourceInput)
up = ta.rma(math.max(change_val, 0), rsiLengthInput)
down = ta.rma(-math.min(change_val, 0), rsiLengthInput)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

// Kesişimleri takip edeceğimiz RSI Hareketli Ortalaması (Sinyal Çizgisi)
rsiSignal = ta.sma(rsi, sigLength)

// =========================================================================
// 3. GRAFİK ÇİZİMLERİ (PLOTS)
// =========================================================================
rsiPlot = plot(rsi, "RSI", color=#7E57C2, linewidth=2)
plot(rsiSignal, "RSI Signal MA", color=color.yellow)

rsiUpperBand = hline(70, "RSI Upper Band", color=#787B86)
midline = hline(50, "RSI Middle Band", color=color.new(#787B86, 50))
rsiLowerBand = hline(30, "RSI Lower Band", color=#787B86)
fill(rsiUpperBand, rsiLowerBand, color=color.rgb(126, 87, 194, 90), title="RSI Background Fill")

// Tetik seviyesini grafikte görmek için kesik çizgi
hline(triggerLevel, "Tetik Seviyesi (Sayaç Sınırı)", color=color.new(color.purple, 50), linestyle=hline.style_dotted)

// =========================================================================
// 4. ÖZEL DİP AL STRATEJİSİ (SAYAÇ MANTIĞI)
// =========================================================================
bullCross = ta.crossover(rsi, rsiSignal)

var int crossCount = 0

// 1. KESİN SIFIRLAMA KOŞULU (RSI tetik seviyesinin üstüne çıkarsa sayacı boz)
if rsi > triggerLevel
    crossCount := 0

// 2. SAYMA KOŞULU (RSI tetik seviyesinin altındayken yukarı keserse sayacı artır)
if bullCross and rsi < triggerLevel
    crossCount += 1

// 3. ÖZEL SİNYAL TETİKLEYİCİ
specialBuy = bullCross and (rsi < triggerLevel) and (crossCount == targetCrossCount)

// Sinyal verdikten sonra döngüyü sıfırla
if specialBuy
    crossCount := 0

// Sinyal Görseli
plotshape(series=specialBuy ? rsiSignal : na, title="Özel AL Sinyali", text="İkili\nDip", style=shape.labelup, location=location.absolute, color=color.lime, textcolor=color.white, size=size.small)

// =========================================================================
// 5. SUPERTREND HESAPLAMASI VE İŞLEME GİRİŞ/ÇIKIŞ (STRATEJİ)
// =========================================================================
[stValue, stDirection] = ta.supertrend(stFactor, atrPeriod)

// SuperTrend Sat Koşulu (Yönün yukarıdan aşağıya dönmesi)
stSellCondition = ta.change(stDirection) > 0

// İşleme Giriş
if specialBuy
    strategy.entry("Long Giriş", strategy.long)

// İşlemden Çıkış
if stSellCondition
    strategy.close("Long Giriş", comment="ST SAT Çıkış")

// =========================================================================
// 6. UYUMSUZLUK HESAPLAMALARI
// =========================================================================
lookbackRight = 5
lookbackLeft = 5
rangeUpper = 60
rangeLower = 5
bearColor = color.red
bullColor = color.green
textColor = color.white
noneColor = color.new(color.white, 100)

_inRange(bool cond) =>
    bars = ta.barssince(cond)
    rangeLower <= bars and bars <= rangeUpper

plFound = false
phFound = false
bullCond = false
bearCond = false

rsiLBR = rsi[lookbackRight]

if calculateDivergence
    plFound := not na(ta.pivotlow(rsi, lookbackLeft, lookbackRight))    
    rsiHL = rsiLBR > ta.valuewhen(plFound, rsiLBR, 1) and _inRange(plFound[1])
    lowLBR = low[lookbackRight]
    priceLL = lowLBR < ta.valuewhen(plFound, lowLBR, 1)
    bullCond := priceLL and rsiHL and plFound

    phFound := not na(ta.pivothigh(rsi, lookbackLeft, lookbackRight))
    rsiLH = rsiLBR < ta.valuewhen(phFound, rsiLBR, 1) and _inRange(phFound[1])
    highLBR = high[lookbackRight]
    priceHH = highLBR > ta.valuewhen(phFound, highLBR, 1)
    bearCond := priceHH and rsiLH and phFound

plot(plFound ? rsiLBR : na, offset = -lookbackRight, title = "Regular Bullish", linewidth = 2, color = (bullCond ? bullColor : noneColor), display = display.pane, editable = calculateDivergence)
plotshape(bullCond ? rsiLBR : na, offset = -lookbackRight, title = "Regular Bullish Label", text = " Bull ", style = shape.labelup, location = location.absolute, color = bullColor, textcolor = textColor, display = display.pane, editable = calculateDivergence)
plot(phFound ? rsiLBR : na, offset = -lookbackRight, title = "Regular Bearish", linewidth = 2, color = (bearCond ? bearColor : noneColor), display = display.pane, editable = calculateDivergence)
plotshape(bearCond ? rsiLBR : na, offset = -lookbackRight, title = "Regular Bearish Label", text = " Bear ", style = shape.labeldown, location = location.absolute, color = bearColor, textcolor = textColor, display = display.pane, editable = calculateDivergence)
